<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F9FF">
    <LinearLayout android:id="@+id/normal_content" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/toolbar" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="12dp" android:layout_width="match_parent" android:layout_height="64dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_classroom" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="@string/app_name" android:textSize="21sp" android:textStyle="bold" android:textColor="#182747" />
            <Button android:id="@+id/menu" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="64dp" android:text="@string/settings" android:textColor="#4168EE" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="false" android:max="100" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="match_parent" />
            <LinearLayout android:id="@+id/error_panel" android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#F7F9FF" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/connection_title" android:textColor="#182747" android:textStyle="bold" android:textSize="24sp" android:gravity="center" />
                <TextView android:id="@+id/error_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/connection_message" android:textColor="#69768D" android:textSize="16sp" android:gravity="center" />
                <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/retry" />
                <Button android:id="@+id/change_server" style="?android:attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/server_settings" android:textColor="#4168EE" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/fullscreen_container" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:visibility="gone" />
</FrameLayout>
